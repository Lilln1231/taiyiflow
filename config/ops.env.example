# ===== 太乙智启后台（必填）=====
# CLI 的 backend_base_url 是 https://snz1.cn，backend_api_prefix 是 /taiyi/composer/api/v1
# Java SDK 自己会拼 /api/v1/...，所以 base-url 填到 /taiyi/composer 为止
TAIYIFLOW_BASE_URL=https://snz1.cn/taiyi/composer

# API Key（明文），SDK 会作为 Authorization: Bearer 发给后台。
# 重要：不是 CLI 配置文件里的 access_token —— 那个是 enc:v1: 开头的加密登录态，取不出来也不能用。
# 正确来源：登录太乙智启网页后台，在“个人中心 / API 密钥”处生成或复制 API Key；或直接向管理员（赵总）申请。
# 不要提交到代码仓库；生产环境建议由 Secret 注入。
TAIYIFLOW_API_KEY=请填写API_KEY

# 可选：留空时由服务端 /api/v1/config 返回默认 Flow（本机 CLI 当前默认 Flow 如下）
TAIYIFLOW_FLOW_ID=cc0d4d2f-bb23-49e0-9166-e9c9700ec361

# ===== 安全边界 =====
# READONLY（默认）：只注册 read_file/list_files/glob_files/search/grep，无 shell
# WHITELIST：注册 shell，但仅允许 OPS_ALLOWED_COMMANDS 中的首 token
# CONFIRM：shell 调用走本地人工审批（或 OPS_AUTO_APPROVE=true 自动批准）
OPS_PERMISSION_MODE=READONLY

# 首 token 精确匹配，不走系统 shell；留空时使用内置保守白名单
# OPS_ALLOWED_COMMANDS=ls,cat,date,whoami,pwd,uname,df,free,ps,uptime,head,tail,id,hostname

# 文件/搜索工具的根目录，normalize + realpath 双重校验，禁止逃逸
OPS_SANDBOX_ROOT=.

# 单轮等待超时（秒），10~6000
OPS_TIMEOUT_SECONDS=180

# CONFIRM 模式下是否自动批准 shell（仅可信内网使用）
OPS_AUTO_APPROVE=false

# ===== 输出 =====
OPS_AUDIT_DIR=./audit
OPS_REPORT_DIR=./reports
